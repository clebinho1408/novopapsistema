  "name": "papsistema",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "TERM_PDFS",
      "bucket_name": "termos-pap"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pap-sistema-producao",
      "database_id": "f57092b8-0b17-4a0f-834a-be1c9c3d9b1a"
    }
  ]
}
